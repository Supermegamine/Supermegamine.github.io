---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { profile, thesis, projects, skills } from '../data/profile';
import { about } from '../data/about';

// '2027-01' -> 'January 2027' (falls back to the raw value if it can't be parsed)
const d = new Date(`${profile.availableFrom}-01T00:00:00Z`);
const avail = isNaN(d.getTime())
  ? profile.availableFrom
  : d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const thesisLink = (thesis as { link?: string }).link;
---
<Layout title={`${profile.name} – ${profile.role}`} description={profile.headline}>
  <div class="page">
    <aside class="side">
      <div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="where">{profile.location}</p>
        <p class="avail"><span class="dot" aria-hidden="true"></span>Available from {avail}</p>
      </div>
      <nav aria-label="Sections">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#thesis">Thesis</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
      <p class="social">
        <a href={profile.github}>GitHub</a>
        <a href={profile.linkedin}>LinkedIn</a>
        {profile.cvUrl && <a href={profile.cvUrl}>CV</a>}
      </p>
    </aside>

    <main>
      <section id="about">
        <h2>About</h2>
        <p class="lead">{about.lead}</p>
        {about.paragraphs.map((t) => <p>{t}</p>)}
        <dl class="facts">
          {about.facts.map((f) => (
            <>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="projects">
        <h2>Projects</h2>
        <ul class="projects">
          {projects.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <p class="stack">{p.stack.join(', ')}</p>
              <p class="links">
                <a href={p.repo}>Source code</a>
                {p.demo && <a href={p.demo}>Live demo</a>}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section id="thesis">
        <h2>Bachelor’s thesis</h2>
        <div class="thesis">
          <h3>{thesis.title}</h3>
          <p>{thesis.summary}</p>
          <p class="stack">{thesis.topics.join(', ')}</p>
          <p class="meta">{thesis.status}</p>
          {thesisLink && <p class="links"><a href={thesisLink}>Read more</a></p>}
        </div>
      </section>

      <section id="skills">
        <h2>Skills</h2>
        <dl class="skills">
          {skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>I’m looking for a backend or software engineering role starting in {avail}.</p>
        <p class="mail"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      </section>
    </main>
  </div>
</Layout>
